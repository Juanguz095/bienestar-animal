<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="0dp" android:layout_height="?attr/actionBarSize" android:background="#FFFFFF"
        app:elevation="2dp" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back" app:title="Denuncias anónimas"
        app:titleTextAppearance="@style/TextAppearance.AdopcionesTitle" />

    <ScrollView android:id="@+id/scroll_header" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_marginStart="16dp"
        android:layout_marginTop="16dp" android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card_list" android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Reporta maltrato de forma anónima"
                android:textColor="#616161" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_denunciar"
                style="@style/Widget.Material3.Button" android:layout_width="wrap_content"
                android:layout_height="40dp" android:text="Denunciar" android:textColor="#FFFFFF"
                android:textSize="12sp" android:textStyle="bold" app:backgroundTint="#E53935"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_denuncias"
        android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="12dp"
        android:clipToPadding="false" android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/scroll_header" />

    <TextView android:id="@+id/tv_vacio" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:gravity="center"
        android:text="No hay denuncias aún" android:textColor="#9E9E9E" android:textSize="13sp"
        android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
