<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize" android:background="#FFFFFF"
        app:elevation="2dp" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back" app:title="Albergues"
        app:titleTextAppearance="@style/TextAppearance.AdopcionesTitle" />

    
    <EditText
        android:id="@+id/et_buscar"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_search_field"
        android:hint="Buscar albergue..."
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#1A1A1A"
        android:textColorHint="#9E9E9E"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    
    <LinearLayout
        android:id="@+id/chips_albergues"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_buscar">

        <TextView android:id="@+id/chip_cercanos"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_selected"
            android:paddingStart="16dp" android:paddingTop="6dp" android:paddingEnd="16dp" android:paddingBottom="6dp"
            android:text="Más cercanos" android:textColor="#1A1A1A" android:textSize="12sp" />

        <TextView android:id="@+id/chip_az"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="16dp" android:paddingTop="6dp" android:paddingEnd="16dp" android:paddingBottom="6dp"
            android:text="A - Z" android:textColor="#616161" android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_albergues" android:layout_width="0dp" android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false" android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/chips_albergues" />

    <TextView android:id="@+id/tv_vacio"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center" android:text="No se encontraron albergues"
        android:textColor="#9E9E9E" android:textSize="13sp" android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
