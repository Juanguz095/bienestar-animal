<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Etiqueta de título -->
    <TextView
        android:id="@+id/tv_titulo_mapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_map"
        android:elevation="4dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="🚨 Alertas cerca de ti"
        android:textColor="#1A1A1A"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Chips de filtro -->
    <LinearLayout
        android:id="@+id/filtros_mapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:elevation="4dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_mapa">

        <!-- Perdidas -->
        <LinearLayout
            android:id="@+id/chip_mapa_perdidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_filtro_on_perdida"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/dot_mapa_perdidas"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_rojo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Perdidas"
                android:textColor="#1A1A1A"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Encontradas -->
        <LinearLayout
            android:id="@+id/chip_mapa_encontradas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_filtro_on_encontrada"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/dot_mapa_encontradas"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_verde" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Encontradas"
                android:textColor="#1A1A1A"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Albergues -->
        <LinearLayout
            android:id="@+id/chip_mapa_albergues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_filtro_on_albergue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/dot_mapa_albergues"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_morado" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Albergues"
                android:textColor="#1A1A1A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón recentrar ubicación -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_recenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Recentrar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_recenter" />

    <!-- Leyenda de tipos de alerta -->
    <LinearLayout
        android:id="@+id/leyenda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_chip_map"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_dot_rojo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Perdidas"
            android:textColor="#616161"
            android:textSize="11sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_dot_verde" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Encontradas"
            android:textColor="#616161"
            android:textSize="11sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_dot_morado" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Albergues"
            android:textColor="#616161"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Panel inferior deslizante (detalle de alerta) -->
    <LinearLayout
        android:id="@+id/panel_alerta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_top"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Fila cierre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panel_cerrar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_rojo"
                android:gravity="center"
                android:text="✕"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Emoji + título -->
        <TextView
            android:id="@+id/panel_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/panel_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/panel_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#616161"
            android:textSize="13sp" />

        <!-- Ubicación -->
        <TextView
            android:id="@+id/panel_ubicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_whatsapp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="💬  WhatsApp"
                android:textColor="#1A1A1A"
                android:textSize="12sp"
                app:strokeColor="#25D366" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_compartir"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="↗  Compartir"
                android:textColor="#1A1A1A"
                android:textSize="12sp"
                app:strokeColor="#1A1A1A" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón de perfil (esquina inferior izquierda) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_perfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Perfil"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_perfil" />

    <!-- Botón flotante que abre el menú de opciones -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Menú de opciones"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_fab_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
